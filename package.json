{
  "name": "roomly",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @roomly/api\" \"npm run dev -w @roomly/web\"",
    "build": "npm run build -w @roomly/api && npm run build -w @roomly/web",
    "test": "npm run test -w @roomly/api",
    "db:generate": "npm run db:generate -w @roomly/api",
    "db:migrate": "npm run db:migrate -w @roomly/api",
    "db:seed": "npm run db:seed -w @roomly/api",
    "db:reset": "npm run db:reset -w @roomly/api",
    "db:inspect": "npm run db:inspect -w @roomly/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
